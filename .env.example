# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this file (.env.example) is the only env
# file committed to the repo.

# --- Supabase ---------------------------------------------------------
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. NEVER prefix this with NEXT_PUBLIC_ or
# reference it from a "use client" component; it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (lib/ai) ----------------------------------------------
# Provider is not finalized yet; placeholder name until the AI phase
# picks one.
AI_PROVIDER_API_KEY=

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
